# Exemplo de configuracao do SERVIDOR (Render, Fly, VPS...). Copie para o painel de variaveis do provedor.
# NENHUM segredo vai para o cliente nem para o repositorio.

NODE_ENV=production
# Geração LOCAL da trilha (tools/audio/generate.mjs). Não enviar ao navegador.
ELEVENLABS_API_KEY=
# PORT: o Render define sozinho. O servidor escuta em 0.0.0.0:$PORT.

# Origens do CLIENTE que podem falar com o servidor (CORS + WebSocket). Separe por virgula, sem barra no fim.
# Ex.: o GitHub Pages do seu usuario: https://SEU-USUARIO.github.io
ALLOWED_ORIGINS=https://SEU-USUARIO.github.io

# Limites (o plano gratuito do Render tem 512 MB de RAM e 0,1 CPU)
MAX_ROOMS=6
MAX_CONNECTIONS=60

# --- Voz (WebRTC) ---
# STUN publico ja vem por padrao. Para redes restritivas (4G/CGNAT/empresas) voce PRECISA de um servidor TURN:
# opcao A) servidor TURN proprio (coturn com "use-auth-secret"):
#   TURN_URLS=turn:turn.exemplo.com:3478?transport=udp,turns:turn.exemplo.com:5349?transport=tcp
#   TURN_SECRET=um-segredo-longo-so-no-servidor
# opcao B) lista fixa (servico de terceiros com credenciais proprias):
#   ICE_SERVERS_JSON=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:...","username":"...","credential":"..."}]
